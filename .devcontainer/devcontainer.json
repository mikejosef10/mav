{
    "name": "MAV-Development-Env",
    "build": { 
        "dockerfile": "Dockerfile",
        "args": { "USERNAME": "developer" }
    },
    "runArgs": [
        "--net=host",
        "--privileged", // Beibehalten für einfachen Zugriff auf /dev/ttyUSBX
        "--device=/dev/bus/usb:/dev/bus/usb" // Verbessert die Erkennung von USB-Geräten
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}", // Ermöglicht GUI-Tools wie RViz2
        "LIBGL_ALWAYS_SOFTWARE": "1"      // Hilft bei Rendering-Problemen in Containern
    },
    "extensions": [
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "twxs.cmake",
        "ms-vscode.cpptools-extension-pack",
        "matelo.arduino", // Optional, falls du den ESP32-Code direkt in VS Code schreiben willst
        "marus25.cortex-debug" // Extrem hilfreich für STM32 Hardware-Debugging
    ],
    "remoteUser": "developer",
    "postCreateCommand": "sudo chown -R developer /workspace" 
}