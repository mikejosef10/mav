# --- Stage 1: Base ---
# System dependencies and Espressif QEMU binary
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    xz-utils \
    libglib2.0-0 \
    libpixman-1-0 \
    libgcrypt20 \
    libsdl2-2.0-0 \
    libslirp0 \
    && rm -rf /var/lib/apt/lists/*

# Install Espressif QEMU fork
RUN mkdir -p /opt/qemu && cd /opt/qemu && \
    wget https://github.com/espressif/qemu/releases/download/esp-develop-9.2.2-20250817/qemu-xtensa-softmmu-esp_develop_9.2.2_20250817-x86_64-linux-gnu.tar.xz && \
    tar -xvf qemu-xtensa-softmmu-esp_develop_9.2.2_20250817-x86_64-linux-gnu.tar.xz --strip-components=1 && \
    rm qemu-xtensa-softmmu-esp_develop_9.2.2_20250817-x86_64-linux-gnu.tar.xz

ENV QEMU_BIN="/opt/qemu/bin/qemu-system-xtensa"
ENV PATH="/opt/qemu/bin:${PATH}"


# --- Stage 2: Builder ---
# Install Python, PlatformIO and esptool
FROM base AS builder

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    git \
    curl \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Set environment variable to allow pip to install packages system-wide if needed (PEP 668)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Use official PlatformIO Core installer to ensure 'penv' is correctly set up
# This solves the "/root/.platformio/penv/bin/activate" missing error for micro-ROS
RUN curl -fsSL https://raw.githubusercontent.com/platformio/platformio-core-installer/master/get-platformio.py -o get-platformio.py && \
    python3 get-platformio.py && \
    rm get-platformio.py

# Add PlatformIO to PATH
ENV PATH="/root/.platformio/penv/bin:${PATH}"

# Install additional test and micro-ROS dependencies into the PlatformIO virtual environment
RUN pip install --no-cache-dir \
    esptool \
    pytest \
    pytest-order \
    pytest-github-actions-annotate-failures \
    catkin-pkg \
    lark-parser \
    colcon-common-extensions \
    importlib-resources \
    pyyaml \
    pytz \
    markupsafe==2.0.1 \
    empy==3.3.4


# --- Stage 3: Development ---
# Environment for interactive development and manual testing
FROM builder AS development

WORKDIR /app
# We don't COPY here to encourage volume mounting, 
# but we provide a default shell
CMD ["/bin/bash"]


# --- Stage 4: CI/CD ---
# Optimized stage for automated testing in the pipeline
FROM builder AS ci

WORKDIR /app
# Copy the source code into the image for standalone execution
COPY . /app/

# Automatically run the test suite using pytest and generate XML report
CMD ["pytest", "-v", "-s", "--junitxml=report.xml", "test/test_qemu.py"]
